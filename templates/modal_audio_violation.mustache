{{!
    @template quizaccess_videocapture/modal_audio_violation

    Audio proctoring violation modal body.

    Example context (json):
    {}
}}
<div class="audio-violation-modal">
    <i class="fa fa-microphone-slash" aria-hidden="true"></i>
    <p>{{#str}} audioviolationmessage, quizaccess_videocapture {{/str}}</p>
    {{#locked}}
        <p class="text-danger">{{#str}} audioviolationlocked, quizaccess_videocapture {{/str}}</p>
    {{/locked}}
    {{^locked}}
        {{#remainingmessage}}
            <p class="text-muted">{{{remainingmessage}}}</p>
        {{/remainingmessage}}
    {{/locked}}
</div>
