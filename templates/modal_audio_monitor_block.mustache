{{!
    @template quizaccess_videocapture/modal_audio_monitor_block

    Blocking modal body displayed when the microphone gets disconnected.

    Example context (json):
    {}
}}
<div class="audio-monitor-block-modal">
    <i class="fa fa-microphone-slash" aria-hidden="true"></i>
    <p data-region="mic-message">{{#str}} audiomonitorlostmessage, quizaccess_videocapture {{/str}}</p>
    <p class="text-danger" data-region="mic-locked" style="display:none;">
        {{#str}} audiomonitorlostlocked, quizaccess_videocapture {{/str}}
    </p>
    <p class="text-muted" data-region="mic-remaining" style="display:none;">{{{remainingmessage}}}</p>
    <p class="text-danger small" data-region="mic-error" style="display:none;">
        {{#str}} audiomonitorretryfailed, quizaccess_videocapture {{/str}}
    </p>
</div>
